{
  "id": "deepagent-result",
  "input": {
    "layout": "flat-json",
    "glob": "*.json",
    "exclude": [
      "run.json"
    ]
  },
  "fields": {
    "task_id": [
      "task_id",
      "_source_stem"
    ],
    "score": [
      "score",
      "scoring.combined_score",
      "result.score"
    ],
    "success": [
      "success",
      "result.success"
    ],
    "error_type": [
      "error_type",
      "error.type"
    ],
    "error_message": [
      "error_message",
      "error.message"
    ],
    "elapsed_sec": [
      "elapsed_sec",
      "agent_elapsed_sec"
    ],
    "artifacts": [
      "artifacts"
    ],
    "artifacts.final_state": [
      "final_state"
    ],
    "metadata": [
      "metadata"
    ]
  },
  "metrics": {
    "tool_calls": {
      "count_events": {
        "path": "events",
        "where": {
          "type": "tool_call"
        }
      }
    },
    "failed_tool_calls": {
      "count_events": {
        "path": "events",
        "where": {
          "type": "tool_call",
          "status": "failed"
        }
      }
    },
    "safety_violations": [
      "metrics.safety_violations"
    ],
    "human_interventions": [
      "metrics.human_interventions"
    ]
  },
  "usage": {
    "parser": "usage-summary",
    "source": "record"
  }
}
